{
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "kysely": "^0.29.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.2": true
  },
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "compile:docker": "tsc -p tsconfig.docker.json",
    "predev": "npm run compile",
    "dev": "node --env-file=.env.dev dist/main.js",
    "premock": "npm run compile",
    "mock": "node --watch --env-file=.env.dev dist/mockServer.js",
    "prestart": "npm run compile",
    "start": "node --env-file=.env dist/main.js"
  }
}