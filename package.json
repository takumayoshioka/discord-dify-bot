{
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "kysely": "^0.29.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "compile:docker": "tsc -p tsconfig.docker.json",
    "predev": "npm run compile",
    "dev": "node --env-file=.env.dev dist/main.js",
    "premock": "npm run compile",
    "mock": "node --watch --env-file=.env.dev dist/mockServer.js",
    "prestart": "npm run compile",
    "start": "node --env-file=.env dist/main.js"
  }
}