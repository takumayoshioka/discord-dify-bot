{
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "googleapis": "^190.0.0",
    "kysely": "^0.29.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true
  },
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "compile:docker": "tsc -p tsconfig.docker.json",
    "predev": "npm run compile",
    "dev": "node --env-file=.env.dev dist/main.js",
    "premock": "npm run compile",
    "mock": "node --watch --env-file=.env.dev dist/mockServer.js",
    "prestart": "npm run compile",
    "start": "node --env-file=.env dist/main.js"
  }
}
